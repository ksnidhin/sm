---
import { whatsappUrl } from "@data/site";
---

<section class="closing section-band" id="contact" aria-labelledby="closing-title">
  <div class="section-shell closing__frame">
    <img src="/assets/logo/shobha-maniyat.svg" alt="Shobha Maniyat" width="230" height="66" loading="lazy" decoding="async" />
    <p class="eyebrow" data-reveal>Plan with experience</p>
    <h2 id="closing-title" data-reveal>For the day people will remember, bring in the team that remembers every detail.</h2>
    <a class="action-link action-link--hero" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>
      Start Your Event
    </a>
  </div>
</section>
